OLLAMA_BASE_URL=http://192.168.1.122:11434

# ── SearXNG ───────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://192.168.1.7:8080

# ── Browserless (Playwright backend — available for future tools) ─────────
BROWSERLESS_URL=http://192.168.1.104:3012

# ── Paperless-NGX ────────────────────────────────────────────────────────
PAPERLESS_BASE_URL=http://<paperless-host>:8000
PAPERLESS_API_TOKEN=<your-api-token>

# ── SQLite Memory ─────────────────────────────────────────────────────────
SQLITE_PATH=/data/memory.db
MEMORY_MAX_TURNS=20

# ── App ───────────────────────────────────────────────────────────────────
APP_PORT=8000
LOG_LEVEL=info
