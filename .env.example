# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── SearXNG ───────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://localhost:8080

# ── Browserless (Playwright backend — available for future tools) ─────────
BROWSERLESS_URL=

# ── Paperless-NGX ────────────────────────────────────────────────────────
PAPERLESS_BASE_URL=
PAPERLESS_API_TOKEN=

# ── SQLite Memory ─────────────────────────────────────────────────────────
SQLITE_PATH=/data/memory.db
MEMORY_MAX_TURNS=20

# ── App ───────────────────────────────────────────────────────────────────
APP_PORT=8000
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────
# Set a random API key to require Bearer auth on all /v1/* endpoints.
# Leave empty to disable auth (NOT recommended for networked deployments).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. "https://chat.example.com"
# Use "*" to allow all (NOT recommended with auth disabled).
CORS_ORIGINS=*